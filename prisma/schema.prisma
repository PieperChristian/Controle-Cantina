generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Aluno {
  id Int @id @default(autoincrement())

  nome String @db.VarChar(100)
  turma String @db.Char(3)
  responsavel String @db.VarChar(100)
  emailResp String @unique @db.VarChar(200)
  saldo Float @db.Float @default(0)
  observacoes String? @db.Text
  depositos Deposito[]
  venda Venda[]

  @@map("alunos")
}

model Deposito {
  id Int @id @default(autoincrement())
  aluno Aluno @relation(fields: [alunoId], references: [id])
  alunoId Int

  tipo TipoDeposito
  valor Float @db.Float
  data DateTime @db.Date @default(now())

  @@map("depositos")
}

model Produto {
  id Int @id @default(autoincrement())
  compra Compra @relation(fields: [compraId], references: [id])
  compraId Int
  estoque Estoque @relation(fields: [estoqueId], references: [id])
  estoqueId Int

  nome String @db.VarChar(100)
  codigo String @db.Char(13)
  descricao String? @db.Text

  @@map("produtos")
}

model Compra {
  id Int @id @default(autoincrement())
  estoque Estoque @relation(fields: [estoqueId], references: [id])
  estoqueId Int

  nome String @db.VarChar(100)
  codigo String @db.Char(13)
  valorCompra Float @db.Float
  quantidade Int @db.Int
  data DateTime @db.Date @default(now())
  observacao String? @db.Text
  produto Produto[]

  @@map("compras")
}

model Estoque {
  id Int @id @default(autoincrement())

  nome String @db.VarChar(100)
  codigo String @db.Char(13)
  quantidade Int @db.Int @default(0)
  valor Float @db.Float
  produto Produto[]
  compra Compra[]
  venda Venda[]

  @@map("estoques")
}

model Venda {
  id Int @id @default(autoincrement())
  aluno Aluno @relation(fields: [alunoId], references: [id])
  alunoId Int
  estoque Estoque @relation(fields: [estoqueId], references: [id])
  estoqueId Int

  quantidade Int @db.Int
  valorVenda Float @db.Float
  data DateTime @db.Date @default(now())

  @@map("vendas")
}

enum TipoDeposito {
  PIX
  Depósito
  Dinheiro
}